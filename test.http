

@base_url = http://127.0.0.1:8000
@user_token = PON_AQUI_UN_TOKEN_DE_USUARIO
@admin_token = PON_AQUI_UN_TOKEN_DE_ADMIN

###
# 🩺 Healthcheck (servicio vivo)
GET {{base_url}}/health
Accept: application/json

###
# 🏠 Root (mensaje de bienvenida)
GET {{base_url}}/
Accept: application/json

############################################################
# AUTH
############################################################

###
# 👤 Registrar nuevo usuario
POST {{base_url}}/auth/register
Content-Type: application/json

{
  "name": "Emiliano",
  "username": "toro",
  "email": "emilianoguevara@gmail.com",
  "password": "123456789",
  "role": "admin"
}

###
# Login (devuelve token JWT)
POST {{base_url}}/auth/login
Content-Type: application/json

{
  "username": "demo_user",
  "password": "clave_segura"
}

###
#  Perfil del usuario autenticado
GET {{base_url}}/auth/me
Authorization: Bearer {{user_token}}
Accept: application/json

###
#  Actualizar perfil
PATCH {{base_url}}/auth/me
Authorization: Bearer {{user_token}}
Content-Type: application/json

{
  "name": "Usuario Demo Actualizado",
  "username": "demo_user"
}

############################################################
# CATEGORIES
############################################################

###
#  Listar categorías
GET {{base_url}}/categories/
Accept: application/json

###
#  Obtener categoría por ID
GET {{base_url}}/categories/1
Accept: application/json

###
#  Crear categoría (admin)
POST {{base_url}}/categories/
Authorization: Bearer {{admin_token}}
Content-Type: application/json

{
  "name": "Libros",
  "description": "Libros"
}

###
#  Actualizar categoría (admin)
PUT {{base_url}}/categories/1
Authorization: Bearer {{admin_token}}
Content-Type: application/json

{
  "name": "Papelería y accesorios",
  "description": "Catálogo completo de útiles."
}

###
#  Eliminar categoría (admin)
DELETE {{base_url}}/categories/1
Authorization: Bearer {{admin_token}}

############################################################
# PRODUCTS
############################################################

###
#  Listar productos con filtros opcionales
GET {{base_url}}/products/?categories=Papelería&price_min=10&price_max=200&sort_by=price&order=asc
Accept: application/json

###
#  Obtener producto por ID
GET {{base_url}}/products/1
Accept: application/json

###
#  Crear producto (admin)
POST {{base_url}}/products/
Authorization: Bearer {{admin_token}}
Content-Type: application/json

{
  "name": "Cuaderno A4",
  "description": "Cuaderno con hojas rayadas de 100 páginas.",
  "price": 5.99,
  "rating": 4,
  "category_id": 1,
  "image_url": "https://example.com/cuaderno-a4.jpg",
  "sku": "CUAD-A4",
  "stock_current": 120,
  "stock_min": 10
}

###
#  Actualizar producto (admin)
PATCH {{base_url}}/products/1
Authorization: Bearer {{admin_token}}
Content-Type: application/json

{
  "price": 6.49,
  "stock_current": 100
}

###
#  Eliminar producto (admin)
DELETE {{base_url}}/products/1
Authorization: Bearer {{admin_token}}

############################################################
# CART (requiere token de usuario)
############################################################

###
#  Obtener carrito del usuario autenticado
GET {{base_url}}/cart/
Authorization: Bearer {{user_token}}
Accept: application/json

###
#  Agregar producto al carrito
POST {{base_url}}/cart/
Authorization: Bearer {{user_token}}
Content-Type: application/json

{
  "product_id": 1,
  "quantity": 2
}

###
#  Actualizar cantidad de un producto
PUT {{base_url}}/cart/
Authorization: Bearer {{user_token}}
Content-Type: application/json

{
  "product_id": 1,
  "quantity": 5
}

###
#  Eliminar un producto del carrito
DELETE {{base_url}}/cart/items/1
Authorization: Bearer {{user_token}}

###
#  Vaciar carrito
DELETE {{base_url}}/cart/
Authorization: Bearer {{user_token}}

############################################################
# ORDERS
############################################################

###
#  Crear una orden (checkout)
POST {{base_url}}/orders/
Authorization: Bearer {{user_token}}
Content-Type: application/json

{
  "shipping_address": "Calle Falsa 123",
  "locality": "Ciudad"
}

###
#  Historial de órdenes del usuario
GET {{base_url}}/orders/my-orders
Authorization: Bearer {{user_token}}
Accept: application/json

###
#  Todas las órdenes (admin)
GET {{base_url}}/orders/admin/all
Authorization: Bearer {{admin_token}}
Accept: application/json

###
#  Actualizar estado de una orden
PATCH {{base_url}}/orders/1/status
Authorization: Bearer {{admin_token}}
Content-Type: application/json

{
  "status": "Completed"
}



